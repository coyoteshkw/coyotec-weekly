---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "flex items-center rounded-md transition-all drop-shadow-sm active:drop-shadow-none hover:brightness-110",
      { "gap-0.5 px-1.5 py-0.5 text-xs": size === "sm" },
      { "gap-1 px-2 py-1 text-sm": size === "lg" },
    ]}
    style="background:rgba(var(--tag-bg),0.85);color:var(--color-background)"
  >
    <span class="font-medium opacity-70">#</span>
    <span class="font-medium">{tagName}</span>
  </a>
</li>

<style is:global>
  :root {
    --tag-bg: 203, 42, 66;
  }
  [data-theme="dark"] {
    --tag-bg: 74, 222, 128;
  }
</style>
