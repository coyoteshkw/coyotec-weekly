---
/**
 * ImageZoom.astro - 图片点击全屏放大组件
 *
 * 在文章页面中让所有图片支持点击放大查看。
 * 用法：放在 PostLayout 或 Layout 中即可自动生效。
 */
---

<div id="image-zoom-root"></div>

<script>
  /**
   * 图片点击全屏放大
   *
   * 功能：
   * - 点击文章中的图片，以全屏遮罩 + 居中显示
   * - 点击遮罩 / 按 ESC / 滚轮关闭
   * - 支持 enter/leave 过渡动画
   */

  const overlay = document.createElement("div");
  overlay.className = "image-zoom-overlay";
  overlay.innerHTML = `<div class="image-zoom-container"><img class="image-zoom-img scale-90 opacity-0" /></div>`;
  document.body.appendChild(overlay);

  const zoomedImg = overlay.querySelector(".image-zoom-img") as HTMLImageElement;

  function open(src: string, alt: string): void {
    zoomedImg.src = src;
    zoomedImg.alt = alt;
    overlay.classList.add("image-zoom-active");
    requestAnimationFrame(() => {
      zoomedImg.classList.add("scale-100", "opacity-100");
      zoomedImg.classList.remove("scale-90", "opacity-0");
    });
  }

  function close(): void {
    overlay.classList.remove("image-zoom-active");
    zoomedImg.classList.add("scale-90", "opacity-0");
    zoomedImg.classList.remove("scale-100", "opacity-100");
  }

  // 点击遮罩或图片关闭
  overlay.addEventListener("click", (e: MouseEvent) => {
    if (e.target === overlay || e.target === overlay.firstElementChild) {
      close();
    }
  });

  // 滚轮关闭
  overlay.addEventListener("wheel", () => close(), { passive: true, once: true });

  // ESC 关闭
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && overlay.classList.contains("image-zoom-active")) {
      close();
    }
  });

  // ---- 图片绑定 ----
  function bindImages(): void {
    const article = document.querySelector("#article");
    if (!article) return;

    const imgs = article.querySelectorAll("img");
    imgs.forEach((img) => {
      if ((img as any).__imageZoomBound) return;
      if (img.closest(".carousel-root, .link-card")) return;

      (img as any).__imageZoomBound = true;
      img.style.cursor = "zoom-in";

      img.addEventListener("click", (e) => {
        e.stopPropagation();
        e.preventDefault();
        const src = img.getAttribute("src");
        if (src) {
          const alt = img.getAttribute("alt") || "";
          open(src, alt);
        }
      }, true); // capture phase
    });
  }

  function init(): void {
    requestAnimationFrame(() => {
      requestAnimationFrame(bindImages);
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .image-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    transition: background 0.3s ease;
    pointer-events: none;
    opacity: 0;
  }

  .image-zoom-overlay.image-zoom-active {
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(6px);
    pointer-events: auto;
    opacity: 1;
  }

  .image-zoom-container {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 95vw;
    max-height: 95vh;
  }

  .image-zoom-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>
