---
/**
 * ImageZoom.astro - 图片点击全屏放大组件
 *
 * 在文章页面中让所有图片支持点击放大查看。
 * 用法：放在 PostLayout 或 Layout 中即可自动生效。
 */
---

<script>
  /**
   * 图片点击全屏放大
   *
   * 功能：
   * - 点击文章中的图片，以全屏遮罩 + 居中显示
   * - 点击遮罩 / 按 ESC / 滚轮关闭
   * - 支持 enter/leave 过渡动画
   */

  class ImageZoom {
    overlay: HTMLElement | null = null;
    zoomedImg: HTMLElement | null = null;

    open(src: string, alt: string): void {
      const overlay = document.createElement("div");
      overlay.className = "image-zoom-overlay";
      overlay.innerHTML = `<div class="image-zoom-container"><img src="${src}" alt="${alt}" class="image-zoom-img scale-90 opacity-0" /></div>`;

      document.body.appendChild(overlay);
      this.overlay = overlay;
      this.zoomedImg = overlay.querySelector(".image-zoom-img") as HTMLElement;
      (overlay as any).__zoomClose = () => this.close();

      // 触発动画
      requestAnimationFrame(() => {
        overlay.classList.add("image-zoom-active");
        if (this.zoomedImg) {
          this.zoomedImg.classList.remove("scale-90", "opacity-0");
          this.zoomedImg.classList.add("scale-100", "opacity-100");
        }
      });

      // 点击遮罩关闭
      overlay.addEventListener("click", (e: MouseEvent) => {
        if (e.target === overlay || e.target === overlay.querySelector(".image-zoom-container")) {
          this.close();
        }
      });

      // 滚轮关闭
      overlay.addEventListener("wheel", () => this.close(), { passive: true, once: true });
    }

    close(): void {
      if (!this.overlay || !this.zoomedImg) return;
      this.overlay.classList.remove("image-zoom-active");
      this.zoomedImg.classList.remove("scale-100", "opacity-100");
      this.zoomedImg.classList.add("scale-90", "opacity-0");
      const overlay = this.overlay;
      this.overlay.addEventListener("transitionend", () => {
        overlay.remove();
      }, { once: true });
      this.overlay = null;
      this.zoomedImg = null;
    }
  }

  // 初始化：给文章正文中的图片绑定 click 事件
  function bindArticleImages(): void {
    const article = document.querySelector("#article");
    if (!article) return;

    const zoom = new ImageZoom();

    // 获取所有文章图片
    const imgs = article.querySelectorAll("img");
    imgs.forEach((img) => {
      // 排除 Carousel、LinkCard 内的图片
      if ((img as any).__imageZoomBound) return;
      if (img.closest(".carousel-root, .link-card")) return;

      (img as any).__imageZoomBound = true;
      img.style.cursor = "zoom-in";

      img.addEventListener("click", (e) => {
        e.stopPropagation();
        e.preventDefault();
        const src = img.getAttribute("src");
        const alt = img.getAttribute("alt") || "";
        if (src) zoom.open(src, alt);
      });
    });
  }

  // 页面加载 / 路由切换后重新绑定
  function init(): void {
    // 延迟确保 DOM 完全渲染
    setTimeout(bindArticleImages, 50);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);

  // ESC 全局关闭
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape") {
      const overlay = document.querySelector(".image-zoom-overlay");
      if (overlay) {
        (overlay as any).__zoomClose?.();
      }
    }
  });
</script>

<style>
  .image-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    transition: background 0.3s ease;
  }

  .image-zoom-overlay.image-zoom-active {
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(6px);
  }

  .image-zoom-container {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 95vw;
    max-height: 95vh;
  }

  .image-zoom-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>
